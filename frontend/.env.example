# Server-only secret. Never prefix this variable with NEXT_PUBLIC_.
PINATA_JWT=your_pinata_jwt

# Domain only, without https:// or a trailing slash.
PINATA_GATEWAY=your-gateway.mypinata.cloud

# Server-only Sepolia HTTPS endpoint used to load NFT and marketplace data.
# This is an RPC URL, never a wallet private key.
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url
